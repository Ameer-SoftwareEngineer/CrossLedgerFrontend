@page "/reset-password"
@inject AuthApiClient AuthApiClient
@inject NavigationManager Navigation

<PageTitle>Reset password - CrossLedger</PageTitle>

<div class="cl-auth-logo">
    <div class="cl-logo-badge cl-logo-badge-lg">
        <CrossLedgerMark Size="30" />
    </div>
    <MudText Typo="Typo.h5" Class="cl-brand">CrossLedger</MudText>
</div>

<MudPaper Class="pa-8 mx-auto mt-4 cl-auth-card" Style="max-width: 440px;" Elevation="0">
    @if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token))
    {
        <MudAlert Severity="Severity.Error">This reset link is missing its email or token. Request a new one below.</MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-6" Href="/forgot-password">
            Request a new link
        </MudButton>
    }
    else if (_succeeded)
    {
        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" Class="mb-3" />
        <MudText Typo="Typo.h5" GutterBottom="true">Password reset</MudText>
        <MudText Typo="Typo.body2" Class="cl-dash-subtitle mb-4">You can now log in with your new password.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Href="/login">Back to log in</MudButton>
    }
    else
    {
        <MudText Typo="Typo.h5" GutterBottom="true">Choose a new password</MudText>

        <MudForm @ref="_form" Model="this">
            <MudTextField @bind-Value="_newPassword" Label="New password" InputType="InputType.Password" Required="true"
                          HelperText="At least 8 characters, with an uppercase letter, a lowercase letter, a digit and a symbol." />
            <MudTextField @bind-Value="_confirmPassword" Label="Confirm new password" InputType="InputType.Password" Required="true" Class="mt-4"
                          Validation="@(new Func<string, string?>(ValidateConfirmPassword))" />

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-6"
                       OnClick="SubmitAsync" Disabled="_isSubmitting">
                @(_isSubmitting ? "Resetting..." : "Reset password")
            </MudButton>
        </MudForm>
    }
</MudPaper>

@code {
    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private MudForm _form = null!;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _succeeded;
    private bool _isSubmitting;
    private string? _error;

    private string? ValidateConfirmPassword(string value) =>
        value == _newPassword ? null : "Passwords don't match.";

    private async Task SubmitAsync()
    {
        await _form.Validate();
        if (!_form.IsValid)
            return;

        _isSubmitting = true;
        _error = null;

        var result = await AuthApiClient.ResetPasswordAsync(Email!, Token!, _newPassword);

        _isSubmitting = false;

        if (!result.IsSuccess)
        {
            _error = result.ErrorMessage;
            return;
        }

        _succeeded = true;
    }
}
