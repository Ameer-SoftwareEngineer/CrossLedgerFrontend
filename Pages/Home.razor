@page "/"
@attribute [Authorize]
@inject WalletApiClient WalletApiClient
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar

<PageTitle>Wallets - CrossLedger</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Your wallets</MudText>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_wallets.Count == 0)
{
    <MudText Typo="Typo.body1" Class="mb-4">You don't have any wallets yet. Add your first currency below.</MudText>
}
else
{
    <MudGrid Class="mb-6">
        @foreach (var wallet in _wallets)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Class="pa-4" Elevation="2">
                    <MudText Typo="Typo.h6">@wallet.Currency</MudText>
                    <MudText Typo="Typo.h4">@SupportedCurrencies.Format(wallet.Balance, wallet.Currency)</MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

<MudDivider Class="my-6" />

<MudText Typo="Typo.h6" GutterBottom="true">Add a currency wallet</MudText>
<MudGrid>
    <MudItem xs="12" sm="6" md="4">
        <MudSelect T="string" @bind-Value="_newCurrency" Label="Currency" Disabled="!AvailableCurrencies.Any()">
            @foreach (var currency in AvailableCurrencies)
            {
                <MudSelectItem T="string" Value="@currency">@currency</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6" md="4" Class="d-flex align-center">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateWalletAsync" Disabled="_isCreating || _newCurrency is null">
            @(_isCreating ? "Adding..." : "Add wallet")
        </MudButton>
    </MudItem>
</MudGrid>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
}

@code {
    private List<WalletSummaryResponse> _wallets = new();
    private bool _isLoading = true;
    private bool _isCreating;
    private string? _newCurrency;
    private string? _error;

    private IEnumerable<string> AvailableCurrencies =>
        SupportedCurrencies.All.Except(_wallets.Select(w => w.Currency));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        var result = await WalletApiClient.ListMineAsync();
        _isLoading = false;

        if (!result.IsSuccess)
        {
            _error = result.ErrorMessage;
            return;
        }

        _wallets = result.Value!.OrderBy(w => w.Currency).ToList();
        _newCurrency = AvailableCurrencies.FirstOrDefault();
    }

    private async Task CreateWalletAsync()
    {
        if (_newCurrency is null)
            return;

        _isCreating = true;
        _error = null;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var ownerId = Guid.Parse(authState.User.FindFirst("sub")!.Value);

        var result = await WalletApiClient.CreateAsync(ownerId, _newCurrency);
        _isCreating = false;

        if (!result.IsSuccess)
        {
            _error = result.ErrorMessage;
            return;
        }

        Snackbar.Add($"{_newCurrency} wallet added.", Severity.Success);
        await LoadAsync();
    }
}
