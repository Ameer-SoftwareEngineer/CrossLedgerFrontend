@page "/"
@attribute [Authorize]
@inject WalletApiClient WalletApiClient
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Dashboard - CrossLedger</PageTitle>

<div class="mb-8">
    <MudText Typo="Typo.h4" Class="cl-dash-title">@Greeting</MudText>
    <MudText Typo="Typo.body1" Class="cl-dash-subtitle">Here's what's happening across your wallets today.</MudText>
</div>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-6">@_error</MudAlert>
    }

    <MudGrid Class="mb-8">
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-6 cl-hero-card" Elevation="0">
                <MudText Typo="Typo.overline" Class="cl-hero-label">Total wallets</MudText>
                <MudText Typo="Typo.h3" Class="cl-hero-value">@_wallets.Count</MudText>
                <MudText Typo="Typo.body2" Class="cl-hero-caption">
                    @(_wallets.Count == 0 ? "No currencies yet" : string.Join(" · ", _wallets.Select(w => w.Currency)))
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="8">
            <MudGrid>
                <MudItem xs="6" sm="3">
                    <MudPaper Class="pa-4 cl-quick-action" Elevation="0" @onclick="@(() => Navigation.NavigateTo("/send"))">
                        <div class="cl-quick-icon"><MudIcon Icon="@Icons.Material.Filled.SwapHorizontalCircle" /></div>
                        <MudText Typo="Typo.body2" Class="mt-2">Send money</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Class="pa-4 cl-quick-action" Elevation="0" @onclick="@(() => Navigation.NavigateTo("/payout"))">
                        <div class="cl-quick-icon"><MudIcon Icon="@Icons.Material.Filled.Public" /></div>
                        <MudText Typo="Typo.body2" Class="mt-2">Send abroad</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Class="pa-4 cl-quick-action" Elevation="0" @onclick="@(() => Navigation.NavigateTo("/transactions"))">
                        <div class="cl-quick-icon"><MudIcon Icon="@Icons.Material.Filled.ReceiptLong" /></div>
                        <MudText Typo="Typo.body2" Class="mt-2">Transactions</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Class="pa-4 cl-quick-action" Elevation="0" @onclick="@(() => Navigation.NavigateTo("/fx-rates"))">
                        <div class="cl-quick-icon"><MudIcon Icon="@Icons.Material.Filled.TrendingUp" /></div>
                        <MudText Typo="Typo.body2" Class="mt-2">FX rates</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.h6" Class="mb-4">Your wallets</MudText>

    <MudGrid>
        @for (var i = 0; i < _wallets.Count; i++)
        {
            var wallet = _wallets[i];
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Class="pa-5 cl-wallet-card" Elevation="0">
                    <div class="cl-wallet-accent @AccentClass(i)"></div>
                    <div class="cl-wallet-card-top">
                        <div class="cl-wallet-badge @AccentClass(i)">@wallet.Currency.Substring(0, 2)</div>
                        <MudText Typo="Typo.subtitle2" Class="cl-wallet-currency">@wallet.Currency</MudText>
                    </div>
                    <MudText Typo="Typo.h4" Class="cl-wallet-balance">@SupportedCurrencies.Format(wallet.Balance, wallet.Currency)</MudText>
                </MudPaper>
            </MudItem>
        }

        <MudItem xs="12" sm="6" md="4">
            <MudPaper Class="pa-5 cl-add-wallet-card" Elevation="0" @onclick="() => _showAddForm = !_showAddForm">
                <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Size="Size.Large" />
                <MudText Typo="Typo.body1" Class="mt-2">Add currency</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (_showAddForm || _wallets.Count == 0)
    {
        <MudPaper Class="pa-6 mt-6" Style="max-width: 480px;" Elevation="0">
            <MudText Typo="Typo.subtitle1" GutterBottom="true">Add a currency wallet</MudText>
            <MudGrid>
                <MudItem xs="8">
                    <MudSelect T="string" @bind-Value="_newCurrency" Label="Currency" Disabled="!AvailableCurrencies.Any()">
                        @foreach (var currency in AvailableCurrencies)
                        {
                            <MudSelectItem T="string" Value="@currency">@currency</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="4" Class="d-flex align-center">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               OnClick="CreateWalletAsync" Disabled="_isCreating || _newCurrency is null">
                        @(_isCreating ? "Adding..." : "Add")
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }
}

@code {
    private List<WalletSummaryResponse> _wallets = new();
    private bool _isLoading = true;
    private bool _isCreating;
    private bool _showAddForm;
    private string? _newCurrency;
    private string? _error;
    private string? _email;

    private string Greeting
    {
        get
        {
            var hour = DateTime.Now.Hour;
            var timeOfDay = hour switch
            {
                < 12 => "morning",
                < 17 => "afternoon",
                _ => "evening",
            };
            return $"Good {timeOfDay}{(_email is null ? "" : $", {_email.Split('@')[0]}")}";
        }
    }

    private IEnumerable<string> AvailableCurrencies =>
        SupportedCurrencies.All.Except(_wallets.Select(w => w.Currency));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _email = authState.User.FindFirst("email")?.Value;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        var result = await WalletApiClient.ListMineAsync();
        _isLoading = false;

        if (!result.IsSuccess)
        {
            _error = result.ErrorMessage;
            return;
        }

        _wallets = result.Value!.OrderBy(w => w.Currency).ToList();
        _newCurrency = AvailableCurrencies.FirstOrDefault();
    }

    private async Task CreateWalletAsync()
    {
        if (_newCurrency is null)
            return;

        _isCreating = true;
        _error = null;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var ownerId = Guid.Parse(authState.User.FindFirst("sub")!.Value);

        var result = await WalletApiClient.CreateAsync(ownerId, _newCurrency);
        _isCreating = false;

        if (!result.IsSuccess)
        {
            _error = result.ErrorMessage;
            return;
        }

        Snackbar.Add($"{_newCurrency} wallet added.", Severity.Success);
        _showAddForm = false;
        await LoadAsync();
    }

    private static string AccentClass(int index) => $"cl-accent-{index % 4}";
}
