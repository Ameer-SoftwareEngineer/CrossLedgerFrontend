@page "/forgot-password"
@inject AuthApiClient AuthApiClient

<PageTitle>Forgot password - CrossLedger</PageTitle>

<div class="cl-auth-logo">
    <div class="cl-logo-badge cl-logo-badge-lg">
        <CrossLedgerMark Size="30" />
    </div>
    <MudText Typo="Typo.h5" Class="cl-brand">CrossLedger</MudText>
</div>

<MudPaper Class="pa-8 mx-auto mt-4 cl-auth-card" Style="max-width: 440px;" Elevation="0">
    @if (_submitted)
    {
        <MudIcon Icon="@Icons.Material.Filled.MarkEmailRead" Size="Size.Large" Color="Color.Primary" Class="mb-3" />
        <MudText Typo="Typo.h5" GutterBottom="true">Check your email</MudText>
        <MudText Typo="Typo.body2" Class="cl-dash-subtitle">
            If an account exists for <strong>@_email</strong>, we've sent a link to reset the password.
        </MudText>
    }
    else
    {
        <MudText Typo="Typo.h5" GutterBottom="true">Forgot your password?</MudText>
        <MudText Typo="Typo.body2" Class="cl-dash-subtitle mb-4">Enter your email and we'll send you a reset link.</MudText>

        <MudForm @ref="_form" Model="this">
            <MudTextField @bind-Value="_email" Label="Email" InputType="InputType.Email" Required="true" />

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-6"
                       OnClick="SubmitAsync" Disabled="_isSubmitting">
                @(_isSubmitting ? "Sending..." : "Send reset link")
            </MudButton>
        </MudForm>
    }

    <MudText Typo="Typo.body2" Class="mt-4">
        <MudLink Href="/login">Back to log in</MudLink>
    </MudText>
</MudPaper>

@code {
    private MudForm _form = null!;
    private string _email = string.Empty;
    private bool _submitted;
    private bool _isSubmitting;
    private string? _error;

    private async Task SubmitAsync()
    {
        await _form.Validate();
        if (!_form.IsValid)
            return;

        _isSubmitting = true;
        _error = null;

        var result = await AuthApiClient.ForgotPasswordAsync(_email);

        _isSubmitting = false;

        if (!result.IsSuccess)
        {
            _error = result.ErrorMessage;
            return;
        }

        _submitted = true;
    }
}
