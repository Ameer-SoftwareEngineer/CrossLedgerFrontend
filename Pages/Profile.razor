@page "/profile"
@attribute [Authorize]
@inject ProfileApiClient ProfileApiClient

<PageTitle>Profile - CrossLedger</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Profile</MudText>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_profile is not null)
{
    <MudPaper Class="pa-6" Style="max-width: 640px;" Elevation="2">
        <MudText Typo="Typo.h6" GutterBottom="true">@FullName</MudText>
        <MudChip T="string" Color="@StatusColor(_profile.RegistrationStatus)" Size="Size.Small" Class="mb-4">@_profile.RegistrationStatus</MudChip>

        <MudGrid>
            <MudItem xs="12" sm="6" Style="min-width: 0;">
                <MudText Typo="Typo.caption" Class="cl-dash-subtitle">Email</MudText>
                <MudText Typo="Typo.body1" Style="overflow-wrap: anywhere;">@_profile.Email</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.caption" Class="cl-dash-subtitle">Phone number</MudText>
                <MudText Typo="Typo.body1">@_profile.PhoneNumber</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.caption" Class="cl-dash-subtitle">Date of birth</MudText>
                <MudText Typo="Typo.body1">@_profile.DateOfBirth.ToString("d MMM yyyy")</MudText>
            </MudItem>
            <MudItem xs="12">
                <MudText Typo="Typo.caption" Class="cl-dash-subtitle">Current address</MudText>
                <MudText Typo="Typo.body1">@_profile.Address, @_profile.City, @_profile.StateProvince, @_profile.Country</MudText>
            </MudItem>
            <MudItem xs="12">
                <MudText Typo="Typo.caption" Class="cl-dash-subtitle">Permanent address</MudText>
                <MudText Typo="Typo.body1">@_profile.PermanentAddress</MudText>
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.caption" Class="cl-dash-subtitle mt-4 d-block">
            To change any of these details, contact support - self-service editing isn't available yet.
        </MudText>
    </MudPaper>
}

@code {
    private MyProfileResponse? _profile;
    private bool _isLoading = true;
    private string? _error;

    private string FullName => _profile is null
        ? string.Empty
        : string.IsNullOrWhiteSpace(_profile.MiddleName)
            ? $"{_profile.FirstName} {_profile.LastName}"
            : $"{_profile.FirstName} {_profile.MiddleName} {_profile.LastName}";

    protected override async Task OnInitializedAsync()
    {
        var result = await ProfileApiClient.GetMyProfileAsync();
        _isLoading = false;

        if (!result.IsSuccess)
        {
            _error = result.ErrorMessage;
            return;
        }

        _profile = result.Value;
    }

    private static Color StatusColor(string status) => status switch
    {
        "Approved" => Color.Success,
        "Rejected" => Color.Error,
        _ => Color.Warning,
    };
}
