@page "/register"
@inject AuthApiClient AuthApiClient
@inject NavigationManager Navigation

<PageTitle>Register - CrossLedger</PageTitle>

<div class="cl-auth-logo">
    <div class="cl-logo-badge cl-logo-badge-lg">
        <CrossLedgerMark Size="30" />
    </div>
    <MudText Typo="Typo.h5" Class="cl-brand">CrossLedger</MudText>
</div>

<MudPaper Class="pa-8 mx-auto mt-4 cl-auth-card" Style="max-width: 420px;" Elevation="0">
    <MudText Typo="Typo.h5" GutterBottom="true">Create an account</MudText>

    <MudForm @ref="_form" Model="_model">
        <MudTextField @bind-Value="_model.Email" Label="Email" InputType="InputType.Email" Required="true" />
        <MudTextField @bind-Value="_model.Password" Label="Password" InputType="InputType.Password" Required="true" Class="mt-4"
                      HelperText="At least 8 characters, with an uppercase letter, a lowercase letter, a digit and a symbol." />

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-6"
                   OnClick="SubmitAsync" Disabled="_isSubmitting">
            @(_isSubmitting ? "Creating account..." : "Register")
        </MudButton>
    </MudForm>

    <MudText Typo="Typo.body2" Class="mt-4">
        Already have an account? <MudLink Href="/login">Log in</MudLink>
    </MudText>
</MudPaper>

@code {
    private MudForm _form = null!;
    private readonly RegisterModel _model = new();
    private string? _error;
    private bool _isSubmitting;

    private async Task SubmitAsync()
    {
        await _form.Validate();
        if (!_form.IsValid)
            return;

        _isSubmitting = true;
        _error = null;

        var registerResult = await AuthApiClient.RegisterAsync(_model.Email, _model.Password);
        if (!registerResult.IsSuccess)
        {
            _isSubmitting = false;
            _error = registerResult.Error;
            return;
        }

        // A fresh registration logs straight in - one less step for a new user, and it
        // exercises both endpoints in the same flow.
        var loginResult = await AuthApiClient.LoginAsync(_model.Email, _model.Password);

        _isSubmitting = false;

        if (!loginResult.IsSuccess)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        Navigation.NavigateTo("/");
    }

    private sealed class RegisterModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
