@page "/"
@page "/transactions"
@attribute [Authorize]
@inject WalletApiClient WalletApiClient
@inject TransferApiClient TransferApiClient
@inject IJSRuntime JsRuntime

<PageTitle>Transaction history - CrossLedger</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Transaction history</MudText>

@if (_isLoadingWallets)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_wallets.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        You don't have any wallets yet. Add one from the <MudLink Href="/wallets">Wallets</MudLink> page.
    </MudAlert>
}
else
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="4" md="3">
            <MudSelect T="Guid" @bind-Value="_selectedWalletId" Label="Wallet" @bind-Value:after="OnFilterChangedAsync">
                @foreach (var wallet in _wallets)
                {
                    <MudSelectItem T="Guid" Value="@wallet.WalletId">@wallet.Currency</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4" md="3">
            <MudDatePicker Label="From" @bind-Date="_fromDate" @bind-Date:after="OnFilterChangedAsync" Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="4" md="3">
            <MudDatePicker Label="To" @bind-Date="_toDate" @bind-Date:after="OnFilterChangedAsync" Clearable="true" />
        </MudItem>
        <MudItem xs="12" md="3" Class="d-flex align-center" Style="gap: 8px;">
            <MudButton Variant="Variant.Outlined" OnClick="ExportCsvAsync" Disabled="_isExporting || _lastTotalCount == 0">
                @(_isExporting ? "Exporting..." : "Download CSV")
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@ConvertHref">
                Convert
            </MudButton>
        </MudItem>
    </MudGrid>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
    }

    <MudTable @ref="_table" ServerData="LoadServerDataAsync" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh Style="width: 40px;"></MudTh>
            <MudTh>Posted</MudTh>
            <MudTh>Direction</MudTh>
            <MudTh Style="text-align: right;">Amount</MudTh>
            <MudTh>Transfer</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd Style="width: 40px;">
                <MudIconButton
                    Icon="@(_expandedTransferIds.Contains(context.TransferId) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                    Size="Size.Small" OnClick="@(() => ToggleLedgerEntriesAsync(context.TransferId))" />
            </MudTd>
            <MudTd DataLabel="Posted">@context.PostedAt.ToLocalTime().ToString("g")</MudTd>
            <MudTd DataLabel="Direction">
                <MudChip T="string" Color="@(context.Direction == "Credit" ? Color.Success : Color.Default)" Size="Size.Small">@context.Direction</MudChip>
            </MudTd>
            <MudTd DataLabel="Amount" Style="text-align: right;">@FormatSignedAmount(context)</MudTd>
            <MudTd DataLabel="Transfer">@context.TransferId</MudTd>
        </RowTemplate>
        <ChildRowContent>
            @if (_expandedTransferIds.Contains(context.TransferId))
            {
                <MudTr>
                    <MudTd colspan="5">
                        @if (_loadingTransferIds.Contains(context.TransferId))
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        }
                        else if (_ledgerEntriesCache.TryGetValue(context.TransferId, out var ledgerEntries) && ledgerEntries.Count > 0)
                        {
                            <MudText Typo="Typo.body2" Class="mb-2"><strong>Double-entry breakdown</strong> - every posting this transfer wrote:</MudText>
                            <MudSimpleTable Dense="true" Elevation="0">
                                <thead>
                                    <tr><th>Wallet</th><th>Direction</th><th style="text-align: right;">Amount</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in ledgerEntries)
                                    {
                                        <tr>
                                            <td>@entry.WalletId</td>
                                            <td>
                                                <MudChip T="string" Color="@(entry.Direction == "Credit" ? Color.Success : Color.Default)" Size="Size.Small">@entry.Direction</MudChip>
                                            </td>
                                            <td style="text-align: right;">@FormatLedgerEntryAmount(entry)</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">Could not load the ledger breakdown for this transfer.</MudText>
                        }
                    </MudTd>
                </MudTr>
            }
        </ChildRowContent>
        <NoRecordsContent>
            <MudText>No transactions in this range yet.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 20, 50 }" />
        </PagerContent>
    </MudTable>
}

@code {
    private List<WalletSummaryResponse> _wallets = new();
    private bool _isLoadingWallets = true;
    private Guid _selectedWalletId;

    private DateTime? _fromDate;
    private DateTime? _toDate;

    private MudTable<TransactionHistoryEntryResponse> _table = null!;
    private List<TransactionHistoryEntryResponse> _lastPage = new();
    private int _lastTotalCount;
    private bool _isExporting;
    private string? _error;

    private string ConvertHref
    {
        get
        {
            var wallet = _wallets.FirstOrDefault(w => w.WalletId == _selectedWalletId);
            return wallet is null ? "/send" : $"/send?fromCurrency={Uri.EscapeDataString(wallet.Currency)}";
        }
    }

    private readonly HashSet<Guid> _expandedTransferIds = new();
    private readonly HashSet<Guid> _loadingTransferIds = new();
    private readonly Dictionary<Guid, List<LedgerEntryDetailResponse>> _ledgerEntriesCache = new();

    protected override async Task OnInitializedAsync()
    {
        var result = await WalletApiClient.ListMineAsync();
        _isLoadingWallets = false;

        if (!result.IsSuccess)
        {
            _error = result.ErrorMessage;
            return;
        }

        _wallets = result.Value!.OrderBy(w => w.Currency).ToList();
        if (_wallets.Count > 0)
            _selectedWalletId = _wallets[0].WalletId;
    }

    private async Task OnFilterChangedAsync()
    {
        if (_table is not null)
            await _table.ReloadServerData();
    }

    private async Task<TableData<TransactionHistoryEntryResponse>> LoadServerDataAsync(TableState state, CancellationToken cancellationToken)
    {
        if (_wallets.Count == 0)
            return new TableData<TransactionHistoryEntryResponse> { Items = Array.Empty<TransactionHistoryEntryResponse>(), TotalItems = 0 };

        _error = null;

        var (fromDate, toDate) = GetDateRange();

        var result = await WalletApiClient.GetTransactionsAsync(_selectedWalletId, state.Page + 1, state.PageSize, fromDate, toDate);

        if (!result.IsSuccess)
        {
            _error = result.ErrorMessage;
            _lastPage = new List<TransactionHistoryEntryResponse>();
            _lastTotalCount = 0;
            StateHasChanged();
            return new TableData<TransactionHistoryEntryResponse> { Items = _lastPage, TotalItems = 0 };
        }

        _lastPage = result.Value!.Entries.ToList();
        _lastTotalCount = result.Value.TotalCount;
        // MudTable invokes ServerData from its own render cycle, not ours - without this,
        // the Download CSV button's Disabled binding (which reads _lastTotalCount) never
        // re-evaluates after the first, empty-list render.
        StateHasChanged();
        return new TableData<TransactionHistoryEntryResponse> { Items = _lastPage, TotalItems = result.Value.TotalCount };
    }

    private (DateTimeOffset? From, DateTimeOffset? To) GetDateRange()
    {
        var fromDate = _fromDate is null ? (DateTimeOffset?)null : new DateTimeOffset(DateTime.SpecifyKind(_fromDate.Value, DateTimeKind.Utc));
        var toDate = _toDate is null ? (DateTimeOffset?)null : new DateTimeOffset(DateTime.SpecifyKind(_toDate.Value.AddDays(1), DateTimeKind.Utc));
        return (fromDate, toDate);
    }

    private static string FormatSignedAmount(TransactionHistoryEntryResponse entry) =>
        $"{(entry.SignedAmount >= 0 ? "+" : string.Empty)}{SupportedCurrencies.Format(entry.SignedAmount, entry.Currency)} {entry.Currency}";

    private static string FormatLedgerEntryAmount(LedgerEntryDetailResponse entry) =>
        $"{(entry.SignedAmount >= 0 ? "+" : string.Empty)}{SupportedCurrencies.Format(entry.SignedAmount, entry.Currency)} {entry.Currency}";

    private async Task ToggleLedgerEntriesAsync(Guid transferId)
    {
        // HashSet.Add returns false when the item was already present - that's the
        // "already expanded" case, so this click means collapse instead.
        if (!_expandedTransferIds.Add(transferId))
        {
            _expandedTransferIds.Remove(transferId);
            return;
        }

        if (_ledgerEntriesCache.ContainsKey(transferId))
            return;

        _loadingTransferIds.Add(transferId);
        var result = await TransferApiClient.GetLedgerEntriesAsync(transferId);
        _loadingTransferIds.Remove(transferId);

        _ledgerEntriesCache[transferId] = result.IsSuccess ? result.Value!.ToList() : new List<LedgerEntryDetailResponse>();
    }

    /// <summary>Exports every row matching the current filters, not just the page on
    /// screen - fetches the full filtered set in one request now that _lastTotalCount is
    /// known from the last server load, rather than the visible page's rows.</summary>
    private async Task ExportCsvAsync()
    {
        if (_lastTotalCount == 0)
            return;

        _isExporting = true;

        var (fromDate, toDate) = GetDateRange();
        var result = await WalletApiClient.GetTransactionsAsync(_selectedWalletId, 1, _lastTotalCount, fromDate, toDate);

        if (!result.IsSuccess)
        {
            _error = result.ErrorMessage;
            _isExporting = false;
            return;
        }

        var csv = new System.Text.StringBuilder();
        csv.AppendLine("PostedAt,Direction,Amount,Currency,SignedAmount,TransferId");
        foreach (var entry in result.Value!.Entries)
        {
            csv.AppendLine($"{entry.PostedAt:O},{entry.Direction},{entry.Amount},{entry.Currency},{entry.SignedAmount},{entry.TransferId}");
        }

        await JsRuntime.InvokeVoidAsync("downloadFile", "transactions.csv", csv.ToString(), "text/csv");
        _isExporting = false;
    }
}
