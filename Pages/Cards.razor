@page "/cards"
@attribute [Authorize]
@inject CardApiClient CardApiClient
@inject NavigationManager Navigation

<PageTitle>Cards - CrossLedger</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Cards</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
    Dev-simulated prepaid cards - no real card network sits behind these. Each card holds its own balance; top it up
    from one of your wallets, then spend from the card.
</MudText>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}
else
{
    <MudPaper Class="pa-2" Style="max-width: 560px;" Elevation="0">
        @if (_cards.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="cl-dash-subtitle pa-4">No cards yet - add one below.</MudText>
        }
        else
        {
            @foreach (var card in _cards)
            {
                <MudPaper Class="pa-4 d-flex align-center cl-card-row" Elevation="0" @onclick="@(() => Navigation.NavigateTo($"/cards/{card.CardId}"))">
                    <div class="cl-card-row-icon">
                        <MudIcon Icon="@Icons.Material.Filled.CreditCard" />
                    </div>
                    <div class="flex-grow-1">
                        <MudText Typo="Typo.subtitle1" Class="cl-card-row-name">@card.CardholderName</MudText>
                        <MudText Typo="Typo.body2" Class="cl-dash-subtitle">@(card.CardType == "Virtual" ? "Virtual card" : "Physical card")</MudText>
                        <MudText Typo="Typo.body2" Class="cl-dash-subtitle" Style="font-family: monospace;">XXXX XXXX XXXX @card.Last4</MudText>
                    </div>
                    <div class="text-right">
                        <MudText Typo="Typo.subtitle2">@SupportedCurrencies.Format(card.Balance, card.Currency) @card.Currency</MudText>
                        <MudChip T="string" Size="Size.Small" Color="@StatusColor(card.Status)">@card.Status</MudChip>
                    </div>
                </MudPaper>
                <MudDivider />
            }
        }

        <MudButton Variant="Variant.Outlined" FullWidth="true" Class="mt-3" Href="/cards/new">
            Add New Card
        </MudButton>
    </MudPaper>
}

@code {
    private List<CardResponse> _cards = new();
    private bool _isLoading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var result = await CardApiClient.ListMineAsync();
        _isLoading = false;

        if (!result.IsSuccess)
        {
            _error = result.ErrorMessage;
            return;
        }

        _cards = result.Value!.OrderByDescending(c => c.IssuedAt).ToList();
    }

    private static Color StatusColor(string status) => status switch
    {
        "Active" => Color.Success,
        "Frozen" => Color.Info,
        "Closed" => Color.Default,
        _ => Color.Default,
    };
}
