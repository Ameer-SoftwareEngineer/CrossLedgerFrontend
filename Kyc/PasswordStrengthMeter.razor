@if (!string.IsNullOrEmpty(Password))
{
    <div class="cl-strength-bars">
        @for (var i = 0; i < 4; i++)
        {
            var filled = i < Score;
            <div class="cl-strength-bar" style="@(filled ? $"background:{BarColor};" : "")"></div>
        }
    </div>
    <MudText Typo="Typo.caption" Style="@($"color:{BarColor};")">@Label</MudText>
}

@code {
    [Parameter] public string Password { get; set; } = string.Empty;

    private int Score => CalculateScore(Password);

    private static int CalculateScore(string password)
    {
        if (string.IsNullOrEmpty(password))
            return 0;

        var score = 0;
        if (password.Length >= 8)
            score++;
        if (password.Any(char.IsUpper) && password.Any(char.IsLower))
            score++;
        if (password.Any(char.IsDigit))
            score++;
        if (password.Any(c => !char.IsLetterOrDigit(c)))
            score++;

        return score;
    }

    private string Label => Score switch
    {
        <= 1 => "Very weak",
        2 => "Weak",
        3 => "Good",
        _ => "Strong",
    };

    private string BarColor => Score switch
    {
        <= 1 => "#EF4444",
        2 => "#F59E0B",
        3 => "#22D3EE",
        _ => "#10B981",
    };
}
