@inherits LayoutComponentBase
@inject AuthApiClient AuthApiClient
@inject NavigationManager Navigation

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6" Class="ml-2">CrossLedger</MudText>
        <AuthorizeView>
            <Authorized>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/" Class="ml-6">Wallets</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/send">Send money</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/payout">Payout</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/transactions">Transactions</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/fx-rates">FX rates</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/security">Security</MudButton>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Admin">
            <Authorized>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/admin">Admin</MudButton>
            </Authorized>
        </AuthorizeView>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Class="mr-4" Typo="Typo.body2">@context.User.FindFirst("email")?.Value</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="LogoutAsync">Log out</MudButton>
            </Authorized>
            <NotAuthorized>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/login">Log in</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private async Task LogoutAsync()
    {
        await AuthApiClient.LogoutAsync();
        Navigation.NavigateTo("/login");
    }
}
