@inherits LayoutComponentBase
@inject AuthApiClient AuthApiClient
@inject NavigationManager Navigation

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="cl-appbar">
        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                               OnClick="@(() => _drawerOpen = !_drawerOpen)" Class="mr-2" />
            </Authorized>
        </AuthorizeView>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="ml-1">
            <div class="cl-logo-badge">
                <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Color="Color.Inherit" Size="Size.Small" />
            </div>
            <MudText Typo="Typo.h6" Class="cl-brand">CrossLedger</MudText>
        </MudStack>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudMenu Dense="true">
                    <ActivatorContent>
                        <MudChip T="string" Variant="Variant.Text" Color="Color.Default" Class="cl-user-chip">
                            <MudAvatar Size="Size.Small" Color="Color.Primary" Class="mr-2">
                                @GetInitial(context.User.FindFirst("email")?.Value)
                            </MudAvatar>
                            @context.User.FindFirst("email")?.Value
                            <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" Class="ml-1" />
                        </MudChip>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Href="/security" Icon="@Icons.Material.Filled.Security">Security</MudMenuItem>
                        <MudDivider />
                        <MudMenuItem OnClick="LogoutAsync" Icon="@Icons.Material.Filled.Logout">Log out</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/login">Log in</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <AuthorizeView>
        <Authorized>
            <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Persistent" ClipMode="DrawerClipMode.Always" Class="cl-drawer">
                <MudNavMenu Class="pa-2">
                    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.AccountBalanceWallet">Wallets</MudNavLink>
                    <MudNavLink Href="/send" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.SwapHorizontalCircle">Send money</MudNavLink>
                    <MudNavLink Href="/payout" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Public">International payout</MudNavLink>
                    <MudNavLink Href="/transactions" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ReceiptLong">Transactions</MudNavLink>
                    <MudNavLink Href="/fx-rates" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.TrendingUp">FX rates</MudNavLink>
                    <MudNavLink Href="/security" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Security">Security</MudNavLink>
                    <AuthorizeView Roles="Admin" Context="adminContext">
                        <Authorized>
                            <MudDivider Class="my-2 mx-2" />
                            <MudText Typo="Typo.overline" Class="px-4 cl-nav-section">Administration</MudText>
                            <MudNavLink Href="/admin" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AdminPanelSettings">Admin console</MudNavLink>
                        </Authorized>
                    </AuthorizeView>
                </MudNavMenu>
            </MudDrawer>
        </Authorized>
    </AuthorizeView>

    <MudMainContent Class="cl-main-content">
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#4F46E5",
            Secondary = "#06B6D4",
            Tertiary = "#7C3AED",
            Background = "#F5F5FF",
            Surface = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#1E1B3A",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#48466D",
            DrawerIcon = "#7A78A3",
            TextPrimary = "#1E1B3A",
            TextSecondary = "#6B6890",
            LinesDefault = "#EBEAF7",
            TableLines = "#EBEAF7",
        },
        Typography = new Typography
        {
            Default = new Default { FontFamily = ["Inter", "Helvetica", "Arial", "sans-serif"] },
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "14px",
            DrawerWidthLeft = "264px",
        },
    };

    private async Task LogoutAsync()
    {
        await AuthApiClient.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    private static string GetInitial(string? email) =>
        string.IsNullOrWhiteSpace(email) ? "?" : email.Trim()[..1].ToUpperInvariant();
}
