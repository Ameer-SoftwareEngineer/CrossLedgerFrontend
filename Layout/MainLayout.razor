@inherits LayoutComponentBase
@inject AuthApiClient AuthApiClient
@inject NavigationManager Navigation

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="cl-appbar">
        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                               OnClick="@(() => _drawerOpen = !_drawerOpen)" Class="mr-2" />
            </Authorized>
        </AuthorizeView>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="ml-1">
            <div class="cl-logo-badge">
                <CrossLedgerMark Size="20" />
            </div>
            <MudText Typo="Typo.h6" Class="cl-brand">CrossLedger</MudText>
        </MudStack>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudMenu Dense="true">
                    <ActivatorContent>
                        <MudChip T="string" Variant="Variant.Text" Color="Color.Default" Class="cl-user-chip">
                            <MudAvatar Size="Size.Small" Color="Color.Primary" Class="mr-2">
                                @GetInitial(context.User.FindFirst("email")?.Value)
                            </MudAvatar>
                            @context.User.FindFirst("email")?.Value
                            <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" Class="ml-1" />
                        </MudChip>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Href="/profile" Icon="@Icons.Material.Filled.Person">Profile</MudMenuItem>
                        <MudMenuItem Href="/security" Icon="@Icons.Material.Filled.Security">Security</MudMenuItem>
                        <MudDivider />
                        <MudMenuItem OnClick="LogoutAsync" Icon="@Icons.Material.Filled.Logout">Log out</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/login">Log in</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <AuthorizeView>
        <Authorized Context="drawerContext">
            <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Persistent" ClipMode="DrawerClipMode.Always" Class="cl-pill-drawer">
                <div class="cl-pill-sidebar">
                    <div class="cl-pill-logo">
                        <CrossLedgerMark Size="20" />
                    </div>

                    <MudTooltip Text="Profile" Placement="Placement.Right">
                        <MudAvatar Size="Size.Medium" Color="Color.Default" Class="cl-pill-avatar" @onclick="@(() => Navigation.NavigateTo("/profile"))">
                            @GetInitial(drawerContext.User.FindFirst("email")?.Value)
                        </MudAvatar>
                    </MudTooltip>

                    <MudDivider Class="cl-pill-divider" />

                    <div class="cl-pill-nav">
                        <MudTooltip Text="Transactions" Placement="Placement.Right">
                            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ReceiptLong" Class="cl-pill-link" />
                        </MudTooltip>
                        <MudTooltip Text="Wallets" Placement="Placement.Right">
                            <MudNavLink Href="/wallets" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccountBalanceWallet" Class="cl-pill-link" />
                        </MudTooltip>
                        <MudTooltip Text="Send money" Placement="Placement.Right">
                            <MudNavLink Href="/send" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.SwapHorizontalCircle" Class="cl-pill-link" />
                        </MudTooltip>
                        <MudTooltip Text="International payout" Placement="Placement.Right">
                            <MudNavLink Href="/payout" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Public" Class="cl-pill-link" />
                        </MudTooltip>
                        <MudTooltip Text="OTC Desk" Placement="Placement.Right">
                            <MudNavLink Href="/otc-desk" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.CurrencyExchange" Class="cl-pill-link" />
                        </MudTooltip>
                        <MudTooltip Text="Cards" Placement="Placement.Right">
                            <MudNavLink Href="/cards" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.CreditCard" Class="cl-pill-link" />
                        </MudTooltip>
                        <MudTooltip Text="FX rates" Placement="Placement.Right">
                            <MudNavLink Href="/fx-rates" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.TrendingUp" Class="cl-pill-link" />
                        </MudTooltip>
                    </div>

                    <AuthorizeView Roles="Admin" Context="adminContext">
                        <Authorized>
                            <MudDivider Class="cl-pill-divider" />
                            <MudTooltip Text="Admin console" Placement="Placement.Right">
                                <MudNavLink Href="/admin" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AdminPanelSettings" Class="cl-pill-link cl-pill-link-accent" />
                            </MudTooltip>
                        </Authorized>
                    </AuthorizeView>

                    <div class="cl-pill-spacer"></div>

                    <div class="cl-pill-bottom">
                        <MudTooltip Text="Security settings" Placement="Placement.Right">
                            <MudNavLink Href="/security" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Security" Class="cl-pill-link" />
                        </MudTooltip>
                        <MudTooltip Text="Log out" Placement="Placement.Right">
                            <MudIconButton Icon="@Icons.Material.Filled.Logout" OnClick="LogoutAsync" Class="cl-pill-link" />
                        </MudTooltip>
                    </div>
                </div>
            </MudDrawer>
        </Authorized>
    </AuthorizeView>

    <MudMainContent Class="cl-main-content">
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#10B981",
            Secondary = "#22D3EE",
            Tertiary = "#0E7490",
            Background = "#F4F7F6",
            Surface = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#0F172A",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#475569",
            DrawerIcon = "#64748B",
            TextPrimary = "#0F172A",
            TextSecondary = "#64748B",
            LinesDefault = "rgba(15,23,42,0.08)",
            TableLines = "rgba(15,23,42,0.08)",
            ActionDefault = "#64748B",
        },
        Typography = new Typography
        {
            Default = new Default { FontFamily = ["Inter", "Helvetica", "Arial", "sans-serif"] },
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "14px",
            DrawerWidthLeft = "118px",
        },
    };

    private async Task LogoutAsync()
    {
        await AuthApiClient.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    private static string GetInitial(string? email) =>
        string.IsNullOrWhiteSpace(email) ? "?" : email.Trim()[..1].ToUpperInvariant();
}
